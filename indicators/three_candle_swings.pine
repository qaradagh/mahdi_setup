//@version=6
// =============================================================================
//  Three-Candle Swings  —  Middle-Swing Liquidity
//  Dow Jones (US30 / YM / DJI) — designed for the 5-minute chart
//
//  LEVEL 1  ·  three-candle swing (fractal)
//      swing high : H[i] > H[i-1]  and  H[i] > H[i+1]
//      swing low  : L[i] < L[i-1]  and  L[i] < L[i+1]
//
//  LEVEL 2  ·  the swing we actually use
//      a level-1 swing that has a level-1 swing of the SAME TYPE on its left
//      and one on its right, and is more extreme than both of them.
//      The middle one is the high / low / liquidity level.
//
//              L1 high            L1 high  (middle = LEVEL 2)          L1 high
//                 ^                        ^^^^^                          ^
//                / \                      /     \                        / \
//               /   \                    /       \                      /   \
//
//  A level-2 swing can only be confirmed once the right-hand level-1 swing
//  exists, so it is printed a few bars after the actual swing candle. Every
//  drawing is anchored back to the real swing bar, and confirmed levels never
//  move afterwards.
// =============================================================================
indicator("Three-Candle Swings — Middle Swing Liquidity", "3C Swings", overlay = true,
     max_lines_count = 500, max_labels_count = 500)

// ─────────────────────────────── Types ───────────────────────────────────────
type Lvl
    float price
    int   bar
    bool  isHigh
    bool  swept = false
    line  ln    = na
    label lb    = na

// ─────────────────────────────── Inputs ──────────────────────────────────────
string gDef = "1 · Swing definition"
int  nbr        = input.int(1, "Neighbour swings on each side", minval = 1, maxval = 3, group = gDef,
     tooltip = "1 = one three-candle swing on the left and one on the right (the default setup).\nRaise it to demand a higher-degree swing.")
bool allowEqual = input.bool(false, "Allow equal highs / lows", group = gDef,
     tooltip = "OFF (strict): a swing high needs H[i] > H[i-1] AND H[i] > H[i+1].\nON: the left-hand comparison accepts equality (>=), so double tops still register. The right-hand side stays strict, so a run of equal candles produces one swing, not many.")
bool waitClose  = input.bool(true, "Detect swings on closed bars only", group = gDef,
     tooltip = "Keeps a swing from appearing and disappearing while the confirmation candle is still forming.")

string gL1 = "2 · Level 1 — three-candle swings"
bool  showL1 = input.bool(false, "Show level-1 swings", group = gL1)
color l1hCol = input.color(color.new(color.teal, 20),   "high", inline = "L1", group = gL1)
color l1lCol = input.color(color.new(color.maroon, 20), "low",  inline = "L1", group = gL1)

string gL2 = "3 · Level 2 — middle swings (our levels)"
bool  showLbl  = input.bool(true, "Label middle swings", group = gL2)
bool  showLine = input.bool(true, "Draw liquidity line", group = gL2)
int   keepLast = input.int(15, "Keep last N levels per side", minval = 1, maxval = 100, group = gL2)
color hiCol    = input.color(color.red,  "sell-side (high)", inline = "L2", group = gL2)
color loCol    = input.color(color.blue, "buy-side (low)",   inline = "L2", group = gL2)
int   lnWidth  = input.int(1, "Line width", minval = 1, maxval = 4, group = gL2)

string gSw = "4 · Liquidity sweep"
string sweepBasis = input.string("Wick", "Sweep confirmed by", options = ["Wick", "Close"], group = gSw)
bool   keepSwept  = input.bool(true, "Keep swept levels on the chart (dotted)", group = gSw)
color  swCol      = input.color(color.new(color.gray, 25), "swept colour", group = gSw)
bool   showX      = input.bool(true, "Mark the sweep bar with x", group = gSw)

string gAl = "5 · Alerts"
bool dynAlerts = input.bool(true, "Fire alert() calls with the price", group = gAl)

// ─────────────────────────────── State ───────────────────────────────────────
// pending level-1 swings: price, bar index, and the first bar that traded through it
var array<float> h1p = array.new<float>()
var array<int>   h1b = array.new<int>()
var array<int>   h1k = array.new<int>()
var array<float> l1p = array.new<float>()
var array<int>   l1b = array.new<int>()
var array<int>   l1k = array.new<int>()
var array<Lvl>   lvls = array.new<Lvl>()

int keepL1 = 2 * nbr + 4

float srcUp = sweepBasis == "Close" ? close : high
float srcDn = sweepBasis == "Close" ? close : low

// ─────────────────────────────── Helpers ─────────────────────────────────────
killDraw(Lvl lv) =>
    line.delete(lv.ln)
    label.delete(lv.lb)

drawLevel(Lvl lv, int endBar) =>
    color c = lv.swept ? swCol : (lv.isHigh ? hiCol : loCol)
    if showLine
        lv.ln := line.new(lv.bar, lv.price, endBar, lv.price, xloc = xloc.bar_index, color = c,
             width = lnWidth, style = lv.swept ? line.style_dotted : line.style_solid)
    if showLbl
        lv.lb := label.new(lv.bar, lv.price, lv.isHigh ? "H" : "L", xloc = xloc.bar_index,
             yloc  = lv.isHigh ? yloc.abovebar : yloc.belowbar,
             style = lv.isHigh ? label.style_label_down : label.style_label_up,
             color = c, textcolor = color.white, size = size.tiny)

markSwept(Lvl lv, int atBar) =>
    lv.swept := true
    if not na(lv.ln)
        line.set_x2(lv.ln, atBar)
        line.set_color(lv.ln, swCol)
        line.set_style(lv.ln, line.style_dotted)
    if not na(lv.lb)
        label.set_color(lv.lb, swCol)
    if showX
        label.new(atBar, lv.price, "x", xloc = xloc.bar_index, style = label.style_none,
             textcolor = lv.isHigh ? hiCol : loCol, size = size.small)

// keep at most `keepLast` level-2 levels per side
trimSide(bool isHigh) =>
    int cnt = 0
    if array.size(lvls) > 0
        for i = 0 to array.size(lvls) - 1
            Lvl t = array.get(lvls, i)
            if t.isHigh == isHigh
                cnt += 1
    while cnt > keepLast
        int idx = -1
        if array.size(lvls) > 0
            for i = 0 to array.size(lvls) - 1
                Lvl t = array.get(lvls, i)
                if t.isHigh == isHigh
                    idx := i
                    break
        if idx < 0
            break
        killDraw(array.get(lvls, idx))
        array.remove(lvls, idx)
        cnt -= 1

// is the swing sitting `nbr` places from the end more extreme than its neighbours?
evalMid(array<float> px, bool isHigh) =>
    int  n    = array.size(px)
    int  need = 2 * nbr + 1
    bool ok   = false
    if n >= need
        int   mi = n - 1 - nbr
        float m  = array.get(px, mi)
        ok := true
        for k = 1 to nbr
            float lft = array.get(px, mi - k)
            float rgt = array.get(px, mi + k)
            bool okL = isHigh ? (allowEqual ? m >= lft : m > lft) : (allowEqual ? m <= lft : m < lft)
            bool okR = isHigh ? m > rgt : m < rgt
            if not (okL and okR)
                ok := false
                break
    ok

// ─────────────────── Track breaches of pending level-1 swings ────────────────
// (so a level that was already taken before it got confirmed is never drawn live)
if array.size(h1p) > 0
    for i = 0 to array.size(h1p) - 1
        if array.get(h1k, i) < 0 and srcUp > array.get(h1p, i)
            array.set(h1k, i, bar_index)
if array.size(l1p) > 0
    for i = 0 to array.size(l1p) - 1
        if array.get(l1k, i) < 0 and srcDn < array.get(l1p, i)
            array.set(l1k, i, bar_index)

// ───────────────────────── Level 1 detection ─────────────────────────────────
// evaluated on the bar AFTER the swing candle → the swing sits at bar_index - 1
bool ready = bar_index > 2 and (not waitClose or barstate.isconfirmed)
bool l1H = ready and (allowEqual ? (high[1] >= high[2] and high[1] > high) : (high[1] > high[2] and high[1] > high))
bool l1L = ready and (allowEqual ? (low[1]  <= low[2]  and low[1]  < low)  : (low[1]  < low[2]  and low[1]  < low))

// ───────────────────────── Level 2 confirmation ──────────────────────────────
bool  newHi   = false
bool  newLo   = false
float newHiPx = na
float newLoPx = na

if l1H
    array.push(h1p, high[1])
    array.push(h1b, bar_index - 1)
    array.push(h1k, -1)
    if evalMid(h1p, true)
        int   mi = array.size(h1p) - 1 - nbr
        Lvl   lv = Lvl.new(price = array.get(h1p, mi), bar = array.get(h1b, mi), isHigh = true)
        int   br = array.get(h1k, mi)                 // already taken before confirmation?
        lv.swept := br >= 0
        if not lv.swept or keepSwept
            drawLevel(lv, lv.swept ? br : bar_index)
            array.push(lvls, lv)
            trimSide(true)
        newHi   := true
        newHiPx := lv.price
    while array.size(h1p) > keepL1
        array.shift(h1p)
        array.shift(h1b)
        array.shift(h1k)

if l1L
    array.push(l1p, low[1])
    array.push(l1b, bar_index - 1)
    array.push(l1k, -1)
    if evalMid(l1p, false)
        int   mi = array.size(l1p) - 1 - nbr
        Lvl   lv = Lvl.new(price = array.get(l1p, mi), bar = array.get(l1b, mi), isHigh = false)
        int   br = array.get(l1k, mi)
        lv.swept := br >= 0
        if not lv.swept or keepSwept
            drawLevel(lv, lv.swept ? br : bar_index)
            array.push(lvls, lv)
            trimSide(false)
        newLo   := true
        newLoPx := lv.price
    while array.size(l1p) > keepL1
        array.shift(l1p)
        array.shift(l1b)
        array.shift(l1k)

// ─────────────────────── Extend / sweep the live levels ──────────────────────
bool  tookHi   = false
bool  tookLo   = false
float tookHiPx = na
float tookLoPx = na

if array.size(lvls) > 0
    for i = 0 to array.size(lvls) - 1
        Lvl lv = array.get(lvls, i)
        if lv.swept
            continue
        bool hit = lv.isHigh ? srcUp > lv.price : srcDn < lv.price
        if hit
            markSwept(lv, bar_index)
            if lv.isHigh
                tookHi   := true
                tookHiPx := lv.price
            else
                tookLo   := true
                tookLoPx := lv.price
        else if not na(lv.ln)
            line.set_x2(lv.ln, bar_index)

if not keepSwept and array.size(lvls) > 0
    for i = array.size(lvls) - 1 to 0
        Lvl lv = array.get(lvls, i)
        if lv.swept
            killDraw(lv)
            array.remove(lvls, i)

// ─────────────────────────────── Plots ───────────────────────────────────────
plotshape(showL1 and l1H, "Level-1 swing high", shape.triangledown, location.abovebar, l1hCol, offset = -1, size = size.tiny)
plotshape(showL1 and l1L, "Level-1 swing low",  shape.triangleup,   location.belowbar, l1lCol, offset = -1, size = size.tiny)

// ─────────────────────────────── Alerts ──────────────────────────────────────
alertcondition(newHi,  "Middle swing HIGH formed", "3C Swings | middle swing HIGH confirmed on {{ticker}} {{interval}}")
alertcondition(newLo,  "Middle swing LOW formed",  "3C Swings | middle swing LOW confirmed on {{ticker}} {{interval}}")
alertcondition(tookHi, "Sell-side liquidity taken", "3C Swings | sell-side liquidity taken on {{ticker}} {{interval}}")
alertcondition(tookLo, "Buy-side liquidity taken",  "3C Swings | buy-side liquidity taken on {{ticker}} {{interval}}")

if dynAlerts
    if newHi
        alert("3C Swings | middle swing HIGH @ " + str.tostring(newHiPx, format.mintick), alert.freq_once_per_bar_close)
    if newLo
        alert("3C Swings | middle swing LOW @ " + str.tostring(newLoPx, format.mintick), alert.freq_once_per_bar_close)
    if tookHi
        alert("3C Swings | sell-side liquidity taken @ " + str.tostring(tookHiPx, format.mintick), alert.freq_once_per_bar)
    if tookLo
        alert("3C Swings | buy-side liquidity taken @ " + str.tostring(tookLoPx, format.mintick), alert.freq_once_per_bar)
