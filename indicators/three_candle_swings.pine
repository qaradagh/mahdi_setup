//@version=6
// =============================================================================
//  Three-Candle Swings  —  Middle-Swing Liquidity
//  Dow Jones (US30 / YM / DJI) — designed for the 5-minute chart
//
//  LEVEL 1 · three-candle swing (equal-price aware)
//      Neighbouring candles that share the same high (or the same low) are
//      treated as ONE candle — a "plateau". A plateau is a swing high when the
//      candle before it AND the candle after it both have a lower high; a swing
//      low when both have a higher low.
//
//          2 equal highs + 1 lower high  →  swing high            ✔
//          3 equal highs                 →  swing high            ✔
//          1 high  + 2 lower highs       →  swing high (classic)  ✔
//
//      The swing is anchored to the FIRST candle of the plateau and a plateau
//      always produces exactly one swing, never one per candle.
//
//  LEVEL 2 · the swing we actually use
//      a level-1 swing that has a level-1 swing of the SAME TYPE on its left
//      and one on its right, and is more extreme than both of them:
//
//              L1 high            L1 high  (middle = LEVEL 2)          L1 high
//                 ^                        ^^^^^                          ^
//                / \                      /     \                        / \
//               /   \                    /       \                      /   \
//
//      Equal level-1 swings (a double top / double bottom at the very same
//      price) still qualify: the level is placed on the FIRST of them, so one
//      line covers both touches.
//
//  CONFIRMATION FILTER · which of those middle swings survive
//      Look at the level-1 swing on the RIGHT of the middle swing and take its
//      swing candle — the rightmost candle when that swing is a plateau. The
//      middle swing is kept only once price CLOSES past the far side of that
//      candle:
//
//          middle swing HIGH  →  a close BELOW the LOW  of the right candle
//          middle swing LOW   →  a close ABOVE the HIGH of the right candle
//
//      A wick through the reference is not enough — only a close counts, and
//      only from the candle after the reference candle onwards. Until then the
//      level is pending and is not drawn; if price takes out the level itself
//      before that close arrives, the level is dropped for good.
// =============================================================================
indicator("Three-Candle Swings — Middle Swing Liquidity", "3C Swings", overlay = true,
     max_lines_count = 500, max_labels_count = 500)

// ─────────────────────────────── Types ───────────────────────────────────────
type Lvl
    float price
    int   bar
    bool  isHigh
    bool  swept = false
    line  ln    = na
    label lb    = na

// one level-1 swing, with the reference candle the filter needs
type Sw
    float price
    int   bar               // first candle of the plateau — where the level sits
    float refPx             // far side of the rightmost candle of the plateau
    int   refBar            // that candle
    int   brokeAt = -1      // first bar that traded through `price`
    int   validAt = -1      // first bar that closed past `refPx`

// a middle swing still waiting for its confirming close
type Pend
    float price
    int   bar
    bool  isHigh
    float refPx
    int   refBar
    line  ln = na
    line  rl = na

// rolling state of a plateau scan (one per side)
type RunState
    float curVal   = na     // price of the plateau being built
    int   curStart = na     // its first bar
    int   curEnd   = na     // its most recent bar
    float curOpp   = na     // far side of that most recent bar
    float prevVal  = na     // price of the plateau before it

// ─────────────────────────────── Inputs ──────────────────────────────────────
string gDef = "1 · Swing definition"
int  nbr       = input.int(1, "Neighbour swings on each side", minval = 1, maxval = 3, group = gDef,
     tooltip = "1 = one three-candle swing on the left and one on the right (the default setup).\nRaise it to demand a higher-degree swing. The confirmation filter always uses the NEAREST swing on the right.")
bool waitClose = input.bool(true, "Detect swings on closed bars only", group = gDef,
     tooltip = "Keeps a swing from appearing and disappearing while the confirmation candle is still forming.")

string gFil = "2 · Confirmation filter"
bool useFilter   = input.bool(true, "Keep only swings confirmed by a close past the right swing", group = gFil,
     tooltip = "Middle swing HIGH: needs a close BELOW the low of the right swing's candle.\nMiddle swing LOW: needs a close ABOVE its high.\nOn a plateau the rightmost candle of the plateau is the reference.")
bool showPending = input.bool(false, "Show swings still waiting (dotted)", group = gFil,
     tooltip = "Draws the pending level and the reference price it is waiting for. Useful for checking the rule.")

string gL1 = "3 · Level 1 — three-candle swings"
bool  showL1 = input.bool(false, "Show level-1 swings", group = gL1)
color l1hCol = input.color(color.new(color.teal, 20),   "high", inline = "L1", group = gL1)
color l1lCol = input.color(color.new(color.maroon, 20), "low",  inline = "L1", group = gL1)

string gL2 = "4 · Level 2 — middle swings (our levels)"
bool  showLbl  = input.bool(true, "Label middle swings", group = gL2)
bool  showLine = input.bool(true, "Draw liquidity line", group = gL2)
bool  dedupe   = input.bool(true, "Merge levels sitting at the same price", group = gL2,
     tooltip = "Stops two separate middle swings at the identical price from drawing two lines on top of each other.")
int   keepLast = input.int(15, "Keep last N levels per side", minval = 1, maxval = 100, group = gL2)
color hiCol    = input.color(color.red,  "sell-side (high)", inline = "L2", group = gL2)
color loCol    = input.color(color.blue, "buy-side (low)",   inline = "L2", group = gL2)
int   lnWidth  = input.int(1, "Line width", minval = 1, maxval = 4, group = gL2)

string gSw = "5 · Liquidity sweep"
string sweepBasis = input.string("Wick", "Sweep confirmed by", options = ["Wick", "Close"], group = gSw)
bool   keepSwept  = input.bool(true, "Keep swept levels on the chart (dotted)", group = gSw)
color  swCol      = input.color(color.new(color.gray, 25), "swept colour", group = gSw)
bool   showX      = input.bool(true, "Mark the sweep bar with x", group = gSw)

string gAl = "6 · Alerts"
bool dynAlerts = input.bool(true, "Fire alert() calls with the price", group = gAl)

// ─────────────────────────────── State ───────────────────────────────────────
var array<Sw>    hSw   = array.new<Sw>()      // pending level-1 swing highs
var array<Sw>    lSw   = array.new<Sw>()      // pending level-1 swing lows
var array<Lvl>   lvls  = array.new<Lvl>()     // drawn levels
var array<Pend>  pends = array.new<Pend>()    // middle swings awaiting confirmation
var array<label> marks = array.new<label>()   // level-1 debug markers

var RunState hSt = RunState.new()
var RunState lSt = RunState.new()

int keepL1 = 2 * nbr + 4

float srcUp  = sweepBasis == "Close" ? close : high
float srcDn  = sweepBasis == "Close" ? close : low
bool  active = not waitClose or barstate.isconfirmed

// ─────────────────────────────── Helpers ─────────────────────────────────────
// two prices count as equal when they are within half a tick of each other
eqPx(float a, float b) => math.abs(a - b) < syminfo.mintick * 0.5

killDraw(Lvl lv) =>
    line.delete(lv.ln)
    label.delete(lv.lb)

drawLevel(Lvl lv, int endBar) =>
    color c = lv.swept ? swCol : (lv.isHigh ? hiCol : loCol)
    if showLine
        lv.ln := line.new(lv.bar, lv.price, endBar, lv.price, xloc = xloc.bar_index, color = c,
             width = lnWidth, style = lv.swept ? line.style_dotted : line.style_solid)
    if showLbl
        lv.lb := label.new(lv.bar, lv.price, lv.isHigh ? "H" : "L", xloc = xloc.bar_index,
             yloc  = lv.isHigh ? yloc.abovebar : yloc.belowbar,
             style = lv.isHigh ? label.style_label_down : label.style_label_up,
             color = c, textcolor = color.white, size = size.tiny)

markSwept(Lvl lv, int atBar) =>
    lv.swept := true
    if not na(lv.ln)
        line.set_x2(lv.ln, atBar)
        line.set_color(lv.ln, swCol)
        line.set_style(lv.ln, line.style_dotted)
    if not na(lv.lb)
        label.set_color(lv.lb, swCol)
    if showX
        label.new(atBar, lv.price, "x", xloc = xloc.bar_index, style = label.style_none,
             textcolor = lv.isHigh ? hiCol : loCol, size = size.small)

// small triangle on every level-1 swing — a visual check of the definition
addMark(int bx, float px, bool isHigh) =>
    if showL1
        array.push(marks, label.new(bx, px, "", xloc = xloc.bar_index,
             yloc  = isHigh ? yloc.abovebar : yloc.belowbar,
             style = isHigh ? label.style_triangledown : label.style_triangleup,
             color = isHigh ? l1hCol : l1lCol, size = size.tiny))
        while array.size(marks) > 200
            label.delete(array.shift(marks))

// is there already a live level at this price on this side?
hasLevel(float px, bool isHigh) =>
    bool found = false
    if array.size(lvls) > 0
        for i = 0 to array.size(lvls) - 1
            Lvl t = array.get(lvls, i)
            if t.isHigh == isHigh and not t.swept and eqPx(t.price, px)
                found := true
                break
    found

// keep at most `keepLast` levels per side
trimSide(bool isHigh) =>
    int cnt = 0
    if array.size(lvls) > 0
        for i = 0 to array.size(lvls) - 1
            Lvl t = array.get(lvls, i)
            if t.isHigh == isHigh
                cnt += 1
    while cnt > keepLast
        int idx = -1
        if array.size(lvls) > 0
            for i = 0 to array.size(lvls) - 1
                Lvl t = array.get(lvls, i)
                if t.isHigh == isHigh
                    idx := i
                    break
        if idx < 0
            break
        killDraw(array.get(lvls, idx))
        array.remove(lvls, idx)
        cnt -= 1

// ── plateau scan ─────────────────────────────────────────────────────────────
// Feed one bar per call. Bars with an equal high (or low) extend the current
// plateau; the first bar with a different price closes it, and that is when we
// can tell whether the closed plateau was a swing.
// Returns [found, swingPrice, swingBar, referencePrice, referenceBar] where the
// reference is the far side of the plateau's LAST candle — what the filter uses.
stepRun(RunState st, float v, float opp, int b, bool isHigh, bool on) =>
    bool  found = false
    float px    = na
    int   bx    = na
    float rpx   = na
    int   rbx   = na
    if on
        if na(st.curVal)
            st.curVal   := v
            st.curStart := b
            st.curEnd   := b
            st.curOpp   := opp
        else if eqPx(v, st.curVal)
            st.curEnd := b                      // plateau grows; reference moves right
            st.curOpp := opp
        else
            if not na(st.prevVal)
                // neighbouring plateaus always differ in price, so > / < is exact
                bool ok = isHigh ? (st.curVal > st.prevVal and st.curVal > v)
                                 : (st.curVal < st.prevVal and st.curVal < v)
                if ok
                    found := true
                    px    := st.curVal
                    bx    := st.curStart
                    rpx   := st.curOpp
                    rbx   := st.curEnd
            st.prevVal  := st.curVal
            st.curVal   := v
            st.curStart := b
            st.curEnd   := b
            st.curOpp   := opp
    [found, px, bx, rpx, rbx]

// is the swing sitting `nbr` places from the end more extreme than its neighbours?
// left side must be beaten outright; on the right an equal swing still counts, so
// the FIRST of two equal swings becomes the level and the second is skipped.
evalMid(array<Sw> sw, bool isHigh) =>
    int  n    = array.size(sw)
    int  need = 2 * nbr + 1
    bool ok   = false
    if n >= need
        int   mi = n - 1 - nbr
        Sw    mo = array.get(sw, mi)
        float m  = mo.price
        ok := true
        for k = 1 to nbr
            Sw    lS  = array.get(sw, mi - k)
            Sw    rS  = array.get(sw, mi + k)
            float lft = lS.price
            float rgt = rS.price
            bool okL = isHigh ? m > lft : m < lft
            bool okR = eqPx(m, rgt) or (isHigh ? m > rgt : m < rgt)
            if not (okL and okR)
                ok := false
                break
    ok

// walk the pending level-1 swings and note when each one is taken out / confirmed
trackSw(array<Sw> arr, bool isHigh) =>
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            Sw s = array.get(arr, i)
            if s.brokeAt < 0 and (isHigh ? srcUp > s.price : srcDn < s.price)
                s.brokeAt := bar_index
            bool hitRef = not na(s.refPx) and (isHigh ? close < s.refPx : close > s.refPx)
            if s.validAt < 0 and active and hitRef
                s.validAt := bar_index

// turn a confirmed middle swing into a drawn level
promote(float px, int bx, bool isHigh, int endBar, bool swept, int sweptAt) =>
    bool made = false
    if not (dedupe and hasLevel(px, isHigh))
        Lvl lv = Lvl.new(price = px, bar = bx, isHigh = isHigh, swept = swept)
        if not swept or keepSwept
            drawLevel(lv, swept ? sweptAt : endBar)
            array.push(lvls, lv)
            trimSide(isHigh)
            made := true
    made

// a middle swing has just been identified: draw it, queue it, or drop it
// m = the middle swing, c = the level-1 swing immediately to its right
tryCreate(Sw m, Sw c, bool isHigh) =>
    bool made = false
    if not useFilter
        made := promote(m.price, m.bar, isHigh, bar_index, m.brokeAt >= 0, m.brokeAt)
    else if m.brokeAt >= 0 and (c.validAt < 0 or m.brokeAt <= c.validAt)
        made := false                            // taken out before it was ever confirmed
    else if c.validAt >= 0
        made := promote(m.price, m.bar, isHigh, bar_index, false, -1)
    else
        Pend pd = Pend.new(price = m.price, bar = m.bar, isHigh = isHigh,
             refPx = c.refPx, refBar = c.refBar)
        if showPending
            color pc = isHigh ? hiCol : loCol
            pd.ln := line.new(pd.bar, pd.price, bar_index, pd.price, xloc = xloc.bar_index,
                 color = color.new(pc, 55), style = line.style_dotted)
            pd.rl := line.new(pd.refBar, pd.refPx, bar_index, pd.refPx, xloc = xloc.bar_index,
                 color = color.new(pc, 72), style = line.style_dotted)
        array.push(pends, pd)
        while array.size(pends) > 60
            Pend old = array.shift(pends)
            line.delete(old.ln)
            line.delete(old.rl)
    made

// ─────────────────── Keep the pending level-1 swings up to date ──────────────
trackSw(hSw, true)
trackSw(lSw, false)

bool  newHi   = false
bool  newLo   = false
float newHiPx = na
float newLoPx = na

// ─────────────────── Resolve middle swings that are waiting ──────────────────
if array.size(pends) > 0
    for i = array.size(pends) - 1 to 0
        Pend pd    = array.get(pends, i)
        bool taken = pd.isHigh ? srcUp > pd.price : srcDn < pd.price
        bool okNow = active and (pd.isHigh ? close < pd.refPx : close > pd.refPx)
        if taken                                  // level gone before confirmation → drop
            line.delete(pd.ln)
            line.delete(pd.rl)
            array.remove(pends, i)
        else if okNow                             // confirming close → draw it
            line.delete(pd.ln)
            line.delete(pd.rl)
            if promote(pd.price, pd.bar, pd.isHigh, bar_index, false, -1)
                if pd.isHigh
                    newHi   := true
                    newHiPx := pd.price
                else
                    newLo   := true
                    newLoPx := pd.price
            array.remove(pends, i)
        else if showPending and not na(pd.ln)
            line.set_x2(pd.ln, bar_index)
            line.set_x2(pd.rl, bar_index)

// ───────────────────────── Level 1 detection ─────────────────────────────────
[l1H, l1Hpx, l1Hbx, l1Hrp, l1Hrb] = stepRun(hSt, high, low,  bar_index, true,  active)
[l1L, l1Lpx, l1Lbx, l1Lrp, l1Lrb] = stepRun(lSt, low,  high, bar_index, false, active)

// ───────────────────────── Level 2 confirmation ──────────────────────────────
if l1H
    addMark(l1Hbx, l1Hpx, true)
    Sw ns = Sw.new(price = l1Hpx, bar = l1Hbx, refPx = l1Hrp, refBar = l1Hrb)
    if active and close < l1Hrp                   // this very bar may already confirm it
        ns.validAt := bar_index
    array.push(hSw, ns)
    if evalMid(hSw, true)
        int mi = array.size(hSw) - 1 - nbr
        Sw  m  = array.get(hSw, mi)
        if tryCreate(m, array.get(hSw, mi + 1), true)
            newHi   := true
            newHiPx := m.price
    while array.size(hSw) > keepL1
        array.shift(hSw)

if l1L
    addMark(l1Lbx, l1Lpx, false)
    Sw ns = Sw.new(price = l1Lpx, bar = l1Lbx, refPx = l1Lrp, refBar = l1Lrb)
    if active and close > l1Lrp
        ns.validAt := bar_index
    array.push(lSw, ns)
    if evalMid(lSw, false)
        int mi = array.size(lSw) - 1 - nbr
        Sw  m  = array.get(lSw, mi)
        if tryCreate(m, array.get(lSw, mi + 1), false)
            newLo   := true
            newLoPx := m.price
    while array.size(lSw) > keepL1
        array.shift(lSw)

// ─────────────────────── Extend / sweep the live levels ──────────────────────
bool  tookHi   = false
bool  tookLo   = false
float tookHiPx = na
float tookLoPx = na

if array.size(lvls) > 0
    for i = 0 to array.size(lvls) - 1
        Lvl lv = array.get(lvls, i)
        if lv.swept
            continue
        bool hit = lv.isHigh ? srcUp > lv.price : srcDn < lv.price
        if hit
            markSwept(lv, bar_index)
            if lv.isHigh
                tookHi   := true
                tookHiPx := lv.price
            else
                tookLo   := true
                tookLoPx := lv.price
        else if not na(lv.ln)
            line.set_x2(lv.ln, bar_index)

if not keepSwept and array.size(lvls) > 0
    for i = array.size(lvls) - 1 to 0
        Lvl lv = array.get(lvls, i)
        if lv.swept
            killDraw(lv)
            array.remove(lvls, i)

// ─────────────────────────────── Alerts ──────────────────────────────────────
alertcondition(newHi,  "Middle swing HIGH confirmed", "3C Swings | middle swing HIGH confirmed on {{ticker}} {{interval}}")
alertcondition(newLo,  "Middle swing LOW confirmed",  "3C Swings | middle swing LOW confirmed on {{ticker}} {{interval}}")
alertcondition(tookHi, "Sell-side liquidity taken",   "3C Swings | sell-side liquidity taken on {{ticker}} {{interval}}")
alertcondition(tookLo, "Buy-side liquidity taken",    "3C Swings | buy-side liquidity taken on {{ticker}} {{interval}}")

if dynAlerts
    if newHi
        alert("3C Swings | middle swing HIGH confirmed @ " + str.tostring(newHiPx, format.mintick), alert.freq_once_per_bar_close)
    if newLo
        alert("3C Swings | middle swing LOW confirmed @ " + str.tostring(newLoPx, format.mintick), alert.freq_once_per_bar_close)
    if tookHi
        alert("3C Swings | sell-side liquidity taken @ " + str.tostring(tookHiPx, format.mintick), alert.freq_once_per_bar)
    if tookLo
        alert("3C Swings | buy-side liquidity taken @ " + str.tostring(tookLoPx, format.mintick), alert.freq_once_per_bar)
